<Application x:Class="SurfaceProFanControl.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#C0C0C0" />
        <SolidColorBrush x:Key="PanelBrush" Color="#C0C0C0" />
        <SolidColorBrush x:Key="PanelAltBrush" Color="#D4D0C8" />
        <SolidColorBrush x:Key="TextBrush" Color="#000000" />
        <SolidColorBrush x:Key="MutedBrush" Color="#404040" />
        <SolidColorBrush x:Key="AccentBrush" Color="#000000" />
        <SolidColorBrush x:Key="WarningBrush" Color="#000000" />
        <SolidColorBrush x:Key="DangerBrush" Color="#000000" />
        <SolidColorBrush x:Key="ClassicLightBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ClassicFaceBrush" Color="#C0C0C0" />
        <SolidColorBrush x:Key="ClassicShadowBrush" Color="#808080" />
        <SolidColorBrush x:Key="ClassicDarkBrush" Color="#404040" />

        <Style TargetType="Window">
            <Setter Property="Background" Value="{StaticResource BackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontFamily" Value="Tahoma" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontFamily" Value="Tahoma" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontFamily" Value="Tahoma" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontFamily" Value="Tahoma" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="ClassicRaisedBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource ClassicFaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ClassicLightBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="5" />
        </Style>
        <Style x:Key="ClassicInsetBorder" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource ClassicDarkBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource ClassicFaceBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="FontFamily" Value="Tahoma" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Chrome" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <Border BorderBrush="{StaticResource ClassicLightBrush}" BorderThickness="1,1,0,0" />
                            <Border BorderBrush="{StaticResource ClassicDarkBrush}" BorderThickness="0,0,1,1" />
                            <Border Margin="1" BorderBrush="{StaticResource ClassicLightBrush}" BorderThickness="1,1,0,0" />
                            <Border Margin="1" BorderBrush="{StaticResource ClassicShadowBrush}" BorderThickness="0,0,1,1" />
                            <ContentPresenter x:Name="ButtonContent"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#B0B0B0" />
                                <Setter TargetName="ButtonContent" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform X="1" Y="1" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="FontFamily" Value="Tahoma" />
            <Setter Property="Padding" Value="3,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <Border BorderBrush="{StaticResource ClassicDarkBrush}" BorderThickness="1,1,0,0" />
                            <Border BorderBrush="{StaticResource ClassicLightBrush}" BorderThickness="0,0,1,1" />
                            <Border Margin="1" BorderBrush="{StaticResource ClassicShadowBrush}" BorderThickness="1,1,0,0" />
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource ClassicFaceBrush}" />
            <Setter Property="FontFamily" Value="Tahoma" />
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource ClassicFaceBrush}" />
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{StaticResource ClassicFaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontFamily" Value="Tahoma" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="{StaticResource ClassicFaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="FontFamily" Value="Tahoma" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid Margin="0,0,2,-1" SnapsToDevicePixels="True">
                            <Border x:Name="TabFace"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{StaticResource ClassicShadowBrush}"
                                    BorderThickness="1"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter ContentSource="Header"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabFace" Property="BorderBrush" Value="{StaticResource ClassicLightBrush}" />
                                <Setter Property="Panel.ZIndex" Value="10" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TabFace" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
