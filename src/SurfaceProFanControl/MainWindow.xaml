<Window x:Class="SurfaceProFanControl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fan Control Center"
        Width="480" Height="410" MinWidth="480" MinHeight="410"
        MaxWidth="480" MaxHeight="410" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="#C0C0C0" Foreground="#000000"
        FontFamily="Tahoma" FontSize="11">
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="27" />
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource ClassicInsetBorder}" Padding="5,3" Margin="0,0,0,4">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Grid VerticalAlignment="Center" Margin="0,0,7,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Image Source="Assets/fan.ico" Width="16" Height="16" Margin="0,0,5,0" SnapsToDevicePixels="True" />
                    <TextBlock x:Name="HeaderText" Grid.Column="1" Text="FAN CONTROL CENTER" FontWeight="Bold" Margin="0,0,7,0" />
                    <TextBlock x:Name="DeviceText" Grid.Column="2" Foreground="#404040" TextTrimming="CharacterEllipsis" />
                </Grid>
                <TextBlock x:Name="ModeText" Grid.Column="1" Text="CONNECTING" FontWeight="Bold" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Margin="0,0,0,4">
            <TabItem x:Name="FanControlTab" Header="Control">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="43" /><RowDefinition Height="31" /><RowDefinition Height="57" />
                        <RowDefinition Height="38" /><RowDefinition Height="31" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="0.95*" /><ColumnDefinition Width="1.15*" /><ColumnDefinition Width="1.2*" /></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource ClassicInsetBorder}" Margin="0,0,3,0" Padding="4,2">
                            <StackPanel><TextBlock x:Name="TemperatureLabel" Text="Temperature" FontSize="9" />
                                <StackPanel Orientation="Horizontal"><TextBlock x:Name="TemperatureText" Text="-- °C" FontWeight="Bold" />
                                    <TextBlock x:Name="CriticalText" Text=" / critical --" FontSize="9" Margin="3,1,0,0" /></StackPanel></StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource ClassicInsetBorder}" Margin="3,0" Padding="4,2">
                            <StackPanel><TextBlock x:Name="FanCommandLabel" Text="Fan command" FontSize="9" />
                                <StackPanel Orientation="Horizontal"><TextBlock x:Name="Fan0RpmText" Text="READY" FontWeight="Bold" />
                                    <TextBlock x:Name="Fan0DutyText" Text=" / two fans" FontSize="9" Margin="3,1,0,0" /></StackPanel></StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource ClassicInsetBorder}" Margin="3,0,0,0" Padding="4,2">
                            <StackPanel><TextBlock x:Name="CpuPowerLabel" Text="CPU / Power" FontSize="9" />
                                <StackPanel Orientation="Horizontal"><TextBlock x:Name="Fan1RpmText" Text="-- %" FontWeight="Bold" />
                                    <TextBlock x:Name="Fan1DutyText" Text=" / --" FontSize="9" Margin="3,1,0,0" /></StackPanel></StackPanel>
                        </Border>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock x:Name="ProfileLabel" Text="Profile" VerticalAlignment="Center" Margin="0,0,7,0" />
                        <ComboBox x:Name="ProfileComboBox" Grid.Column="1" Height="24" VerticalContentAlignment="Center" SelectionChanged="ProfileComboBox_SelectionChanged" />
                    </Grid>
                    <Border Grid.Row="2" Style="{StaticResource ClassicRaisedBorder}" Margin="0,4,0,0" Padding="5,3">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="24" /><RowDefinition Height="20" /></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="44" /></Grid.ColumnDefinitions>
                            <TextBlock x:Name="AggressivenessLabel" Text="Cooling aggressiveness" VerticalAlignment="Center" />
                            <Slider x:Name="AggressivenessSlider" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Margin="7,0" ValueChanged="AggressivenessSlider_ValueChanged" />
                            <TextBox x:Name="AggressivenessTextBox" Grid.Column="2" Height="21" VerticalContentAlignment="Center" HorizontalContentAlignment="Right"
                                     LostKeyboardFocus="AggressivenessTextBox_LostKeyboardFocus" KeyDown="AggressivenessTextBox_KeyDown" />
                            <TextBlock x:Name="AggressivenessPolicyText" Grid.Row="1" Grid.ColumnSpan="3" FontSize="9" Foreground="#404040"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>
                    <Grid Grid.Row="3" Margin="0,5,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="63" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <ComboBox x:Name="BoostMinutesComboBox" Height="28" VerticalContentAlignment="Center" SelectionChanged="BoostMinutesComboBox_SelectionChanged">
                            <ComboBoxItem Tag="5">5 min</ComboBoxItem><ComboBoxItem Tag="15">15 min</ComboBoxItem>
                            <ComboBoxItem Tag="30">30 min</ComboBoxItem><ComboBoxItem Tag="60">60 min</ComboBoxItem>
                        </ComboBox>
                        <Button x:Name="TimedBoostButton" Grid.Column="1" Content="Timed MAX" Margin="4,0,2,0" FontWeight="Bold" Click="TimedBoostButton_Click" />
                        <Button x:Name="ConstantMaximumButton" Grid.Column="2" Content="CONSTANT MAX" Margin="2,0" FontWeight="Bold" Click="ConstantMaximumButton_Click" />
                        <Button x:Name="AutomaticButton" Grid.Column="3" Content="AUTOMATIC" Margin="2,0,0,0" FontWeight="Bold" Click="AutomaticButton_Click" />
                    </Grid>
                    <Grid Grid.Row="4" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock x:Name="VerifiedPeakLabel" Text="Verified peak RPM:" VerticalAlignment="Center" />
                        <TextBlock x:Name="VerifiedPeakRpmText" Grid.Column="1" Text="10,219 / 9,756" FontWeight="Bold" VerticalAlignment="Center" Margin="5,0" />
                        <TextBlock x:Name="BoostCountdownText" Grid.Column="2" Text="Boost ready" VerticalAlignment="Center" Foreground="#404040" />
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem x:Name="CurveTab" Header="Fan curve">
                <Grid Margin="9,7">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="24" /><RowDefinition Height="32" /><RowDefinition Height="32" />
                        <RowDefinition Height="30" /><RowDefinition Height="25" /><RowDefinition Height="62" />
                        <RowDefinition Height="45" />
                    </Grid.RowDefinitions>
                    <CheckBox x:Name="CustomCurveEnabledCheckBox" Content="Enable custom AUTO / MAX curve"
                              Checked="CustomCurveSetting_Changed" Unchecked="CustomCurveSetting_Changed" />
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="103"/><ColumnDefinition Width="*"/><ColumnDefinition Width="47"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="CurveTurnOnLabel" Text="MAX threshold" VerticalAlignment="Center" />
                        <Slider x:Name="CurveTurnOnSlider" Grid.Column="1" Minimum="50" Maximum="90" TickFrequency="1" IsSnapToTickEnabled="True"
                                Margin="7,0" ValueChanged="CurveSlider_ValueChanged" />
                        <TextBlock x:Name="CurveTurnOnValueText" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right" FontWeight="Bold" />
                    </Grid>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="103"/><ColumnDefinition Width="*"/><ColumnDefinition Width="47"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="CurveTurnOffLabel" Text="Quiet threshold" VerticalAlignment="Center" />
                        <Slider x:Name="CurveTurnOffSlider" Grid.Column="1" Minimum="40" Maximum="87" TickFrequency="1" IsSnapToTickEnabled="True"
                                Margin="7,0" ValueChanged="CurveSlider_ValueChanged" />
                        <TextBlock x:Name="CurveTurnOffValueText" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right" FontWeight="Bold" />
                    </Grid>
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="103"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="CurveDwellLabel" Text="Minimum hold" VerticalAlignment="Center" />
                        <ComboBox x:Name="CurveDwellComboBox" Grid.Column="1" Height="24" VerticalContentAlignment="Center" SelectionChanged="CurveDwellComboBox_SelectionChanged">
                            <ComboBoxItem Tag="30">30 s</ComboBoxItem><ComboBoxItem Tag="60">60 s</ComboBoxItem>
                            <ComboBoxItem Tag="120">120 s</ComboBoxItem><ComboBoxItem Tag="300">300 s</ComboBoxItem>
                        </ComboBox>
                    </Grid>
                    <CheckBox x:Name="PredictiveCoolingCheckBox" Grid.Row="4" Content="Start cooling early when temperature rises quickly"
                              Checked="CustomCurveSetting_Changed" Unchecked="CustomCurveSetting_Changed" />
                    <Border Grid.Row="5" Style="{StaticResource ClassicInsetBorder}" Margin="0,4,0,0" Padding="4">
                        <Grid>
                            <Canvas x:Name="CurvePreviewCanvas" Height="45" Background="#FFFFFF" ClipToBounds="True">
                                <Line X1="0" Y1="35" X2="440" Y2="35" Stroke="#D0D0D0" StrokeThickness="1" />
                                <Line X1="0" Y1="11" X2="440" Y2="11" Stroke="#D0D0D0" StrokeThickness="1" />
                                <Polyline x:Name="CurvePreviewLine" Stroke="#000000" StrokeThickness="2" />
                                <Line x:Name="CurveCurrentMarker" Y1="2" Y2="43" Stroke="#808080" StrokeThickness="1" StrokeDashArray="2,2" Visibility="Collapsed" />
                            </Canvas>
                        </Grid>
                    </Border>
                    <Border Grid.Row="6" Style="{StaticResource ClassicRaisedBorder}" Margin="0,5,0,0" Padding="6,4">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock x:Name="CurveSensorText" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="CurveHintText" Grid.Row="1" FontSize="9" Foreground="#404040" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="ProfilesTab" Header="Profiles">
                <Grid Margin="10,8">
                    <Grid.RowDefinitions><RowDefinition Height="30" /><RowDefinition Height="45" /><RowDefinition Height="45" />
                        <RowDefinition Height="58" /><RowDefinition Height="34" /></Grid.RowDefinitions>
                    <CheckBox x:Name="UsePowerProfilesCheckBox" Content="Separate AC and battery profiles"
                              Checked="PowerProfilesCheckBox_Changed" Unchecked="PowerProfilesCheckBox_Changed" />
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="45"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="AcPolicyLabel" Text="On AC" VerticalAlignment="Center" />
                        <Slider x:Name="AcAggressivenessSlider" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                Margin="7,0" ValueChanged="PowerSlider_ValueChanged" />
                        <TextBlock x:Name="AcAggressivenessText" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right" />
                    </Grid>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="45"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="BatteryPolicyLabel" Text="On battery" VerticalAlignment="Center" />
                        <Slider x:Name="BatteryAggressivenessSlider" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                Margin="7,0" ValueChanged="PowerSlider_ValueChanged" />
                        <TextBlock x:Name="BatteryAggressivenessText" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right" />
                    </Grid>
                    <Border Grid.Row="3" Style="{StaticResource ClassicInsetBorder}" Padding="6,5"><TextBlock x:Name="PowerProfileHintText" TextWrapping="Wrap" /></Border>
                    <Grid Grid.Row="4" Margin="0,5,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Button x:Name="ImportProfileButton" Content="Import" Margin="0,0,3,0" Click="ImportProfileButton_Click" />
                        <Button x:Name="ExportProfileButton" Grid.Column="1" Content="Export" Margin="3,0,0,0" Click="ExportProfileButton_Click" />
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem x:Name="StatusTab" Header="Status">
                <Grid Margin="9,7">
                    <Grid.RowDefinitions><RowDefinition Height="42" /><RowDefinition Height="44" /><RowDefinition Height="68" />
                        <RowDefinition Height="34" /><RowDefinition Height="28" /></Grid.RowDefinitions>
                    <Border Style="{StaticResource ClassicInsetBorder}" Padding="6,4"><StackPanel>
                        <TextBlock x:Name="HardwareSupportLabel" Text="Hardware support" FontSize="9" />
                        <TextBlock x:Name="HardwareSupportText" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                    </StackPanel></Border>
                    <Grid Grid.Row="1" Margin="0,5,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource ClassicInsetBorder}" Margin="0,0,3,0" Padding="6,3"><StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="Fan0MeasureLabel" Text="Fan 1: "/><TextBlock x:Name="MeasuredFan0Text" Text="-- RPM" FontWeight="Bold"/></StackPanel></Border>
                        <Border Grid.Column="1" Style="{StaticResource ClassicInsetBorder}" Margin="3,0,0,0" Padding="6,3"><StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="Fan1MeasureLabel" Text="Fan 2: "/><TextBlock x:Name="MeasuredFan1Text" Text="-- RPM" FontWeight="Bold"/></StackPanel></Border>
                    </Grid>
                    <Border Grid.Row="2" Style="{StaticResource ClassicInsetBorder}" Margin="0,5,0,0" Padding="4">
                        <Canvas x:Name="TemperatureGraphCanvas" Height="54" Background="#FFFFFF" ClipToBounds="True">
                            <Line X1="0" Y1="18" X2="420" Y2="18" Stroke="#D0D0D0" StrokeThickness="1" />
                            <Line X1="0" Y1="36" X2="420" Y2="36" Stroke="#D0D0D0" StrokeThickness="1" />
                            <Polyline x:Name="TemperatureGraphLine" Stroke="#000000" StrokeThickness="1" />
                        </Canvas>
                    </Border>
                    <Grid Grid.Row="3" Margin="0,5,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Button x:Name="MeasureRpmButton" Content="Measure RPM" Margin="0,0,2,0" Click="MeasureRpmButton_Click" />
                        <Button x:Name="HealthTestButton" Grid.Column="1" Content="Fan test" Margin="2,0" Click="HealthTestButton_Click" />
                        <Button x:Name="OpenTelemetryButton" Grid.Column="2" Content="Open CSV" Margin="2,0,0,0" Click="OpenTelemetryButton_Click" />
                    </Grid>
                    <TextBlock x:Name="LastMeasurementText" Grid.Row="4" VerticalAlignment="Center" Foreground="#404040"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                </Grid>
            </TabItem>

            <TabItem x:Name="SettingsTab" Header="Settings">
                <Grid Margin="10,7">
                    <Grid.RowDefinitions><RowDefinition Height="27" /><RowDefinition Height="27" /><RowDefinition Height="27" />
                        <RowDefinition Height="27" /><RowDefinition Height="27" /><RowDefinition Height="30" />
                        <RowDefinition Height="30" /><RowDefinition Height="34" /></Grid.RowDefinitions>
                    <CheckBox x:Name="StartWithWindowsCheckBox" Content="Start with Windows" Checked="StartWithWindowsCheckBox_Changed" Unchecked="StartWithWindowsCheckBox_Changed" />
                    <CheckBox x:Name="StartMinimizedCheckBox" Grid.Row="1" Content="Start minimized" Checked="UserSettingCheckBox_Changed" Unchecked="UserSettingCheckBox_Changed" />
                    <CheckBox x:Name="AlwaysOnTopCheckBox" Grid.Row="2" Content="Always on top" Checked="UserSettingCheckBox_Changed" Unchecked="UserSettingCheckBox_Changed" />
                    <CheckBox x:Name="CloseToTrayCheckBox" Grid.Row="3" Content="Minimize to tray on close" Checked="UserSettingCheckBox_Changed" Unchecked="UserSettingCheckBox_Changed" />
                    <CheckBox x:Name="NotificationsCheckBox" Grid.Row="4" Content="Show notifications" Checked="UserSettingCheckBox_Changed" Unchecked="UserSettingCheckBox_Changed" />
                    <Grid Grid.Row="5">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="LanguageLabel" Text="Language" VerticalAlignment="Center" />
                        <ComboBox x:Name="LanguageComboBox" Grid.Column="1" Height="24" VerticalContentAlignment="Center" SelectionChanged="LanguageComboBox_SelectionChanged" />
                    </Grid>
                    <Grid Grid.Row="6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="StartupDelayLabel" Text="Startup delay" VerticalAlignment="Center" />
                        <ComboBox x:Name="StartupDelayComboBox" Grid.Column="1" Height="24" VerticalContentAlignment="Center" SelectionChanged="StartupDelayComboBox_SelectionChanged">
                            <ComboBoxItem Tag="0">0 s</ComboBoxItem><ComboBoxItem Tag="15">15 s</ComboBoxItem>
                            <ComboBoxItem Tag="30">30 s</ComboBoxItem><ComboBoxItem Tag="60">60 s</ComboBoxItem>
                        </ComboBox>
                    </Grid>
                    <Grid Grid.Row="7" Margin="0,5,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Button x:Name="ResetControlButton" Content="Reset control" Margin="0,0,3,0" Click="ResetControlButton_Click" />
                        <Button x:Name="OpenLogButton" Grid.Column="1" Content="Log" Margin="3,0,0,0" Click="OpenLogButton_Click" />
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Style="{StaticResource ClassicInsetBorder}" Padding="5,3">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="Connecting…" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="LastUpdateText" Grid.Column="1" Text="--:--:--" VerticalAlignment="Center" Margin="8,0,0,0" />
            </Grid>
        </Border>
    </Grid>
</Window>
